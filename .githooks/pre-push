#!/bin/sh
# The push milestone (docs/testing.md): every check runs locally before CI sees the branch. First the branch and
# quiet-hours rules (tools/git-guard.mjs reads the refs git sends on stdin), then the full checks: the commit checks,
# the golden outputs and the vulnerability scan. A failure stops the push. Never skip it with --no-verify without the
# owner's yes.
node tools/git-guard.mjs pre-push "$@" || exit 1
exec node tools/check.mjs full
